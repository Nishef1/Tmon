# Copy to .env and change the values. Never commit .env.
POSTGRES_USER=tmon
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tmon
MINIO_ROOT_USER=tmon
MINIO_ROOT_PASSWORD=change-me-too
# Overrides for running the backend outside Docker (prefix TMON_):
TMON_DATABASE_URL=postgresql+psycopg://tmon:change-me@localhost:5432/tmon
TMON_REDIS_URL=redis://localhost:6379/0
TMON_MINIO_ENDPOINT=localhost:9000
TMON_MINIO_ACCESS_KEY=tmon
TMON_MINIO_SECRET_KEY=change-me-too
# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
