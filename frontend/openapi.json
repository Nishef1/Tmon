          },
          "timeframe": {
            "title": "Timeframe",
            "type": "string"
          },
          "top_reasons": {
            "items": {
              "$ref": "#/components/schemas/Reason"
            },
            "title": "Top Reasons",
            "type": "array"
          }
        },
        "required": [
          "id",
          "date",
          "timeframe",
          "rank",
          "instrument",
          "entry_price",
          "entry_rule",
          "take_profit",
          "stop_loss",
          "horizon_days",
          "p_win",
          "ev",
          "confidence_tier",
          "position_pct",
          "top_reasons",
          "risks",
          "model_version",
          "data_snapshot_id",
          "outcome",
          "realized_return",
          "outcome_date"
        ],
        "title": "SignalOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": ["loc", "msg", "type"],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Tmon API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": ["meta"]
      }
    },
    "/instruments/{instrument_id}": {
      "get": {
        "description": "Adjusted daily candles (never raw prices), the latest stored features and this symbol's\npublished signals.",
        "operationId": "instrument_detail_instruments__instrument_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "instrument_id",
            "required": true,
            "schema": {
              "title": "Instrument Id",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "days",
            "required": false,
            "schema": {
              "default": 250,
              "maximum": 1500,
              "minimum": 20,
              "title": "Days",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstrumentDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Instrument Detail",
        "tags": ["instruments"]
      }
    },
    "/instruments/{instrument_id}/agm": {
      "get": {
        "description": "Hold for the AGM or sell before it (docs/05). DPS and timing come from the caller; the\nprice, the risk-free rate (default for r_m and r_alt) and the costs come from the database,\nand every input says where it came from.",
        "operationId": "agm_decision_instruments__instrument_id__agm_get",
        "parameters": [
          {
            "in": "path",
            "name": "instrument_id",
            "required": true,
            "schema": {
              "title": "Instrument Id",
              "type": "integer"
            }
          },
          {
            "description": "dividend per share, rial",
            "in": "query",
            "name": "dps",
            "required": true,
            "schema": {
              "description": "dividend per share, rial",
              "minimum": 0,
              "title": "Dps",
              "type": "number"
            }
          },
          {
            "description": "k",
            "in": "query",
            "name": "months_to_payment",
            "required": true,
            "schema": {
              "description": "k",
              "maximum": 60,
              "minimum": 0,
              "title": "Months To Payment",
              "type": "number"
            }
          },
          {
            "description": "E[ΔP_after], rial",
            "in": "query",
            "name": "expected_drop_after",
            "required": false,
            "schema": {
              "default": 0.0,
              "description": "E[ΔP_after], rial",
              "title": "Expected Drop After",
              "type": "number"
            }
          },
          {
            "description": "rial per share",
            "in": "query",
            "name": "dividend_tax",
            "required": false,
            "schema": {
              "default": 0.0,
              "description": "rial per share",
              "minimum": 0,
              "title": "Dividend Tax",
              "type": "number"
            }
          },
          {
            "description": "k'; default k",
            "in": "query",
            "name": "months_alt",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 60,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "k'; default k",
              "title": "Months Alt"
            }
          },
          {
            "description": "r_m",
            "in": "query",
            "name": "monthly_discount",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "exclusiveMinimum": -1,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "r_m",
              "title": "Monthly Discount"
            }
          },
          {
            "description": "r_alt",
            "in": "query",
            "name": "alt_monthly_return",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "exclusiveMinimum": -1,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "r_alt",
              "title": "Alt Monthly Return"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgmDecisionOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Agm Decision",
        "tags": ["instruments"]
      }
    },
    "/instruments/{instrument_id}/live": {
      "get": {
        "description": "The latest stored intraday snapshot and 5-level order book. ``available=false`` is a normal\nstate (market closed, or the live poller is not running).",
        "operationId": "instrument_live_instruments__instrument_id__live_get",
        "parameters": [
          {
            "in": "path",
            "name": "instrument_id",
            "required": true,
            "schema": {
              "title": "Instrument Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Instrument Live",
        "tags": ["instruments"]
      }
    },
    "/metrics/calibration": {
      "get": {
        "description": "Calibration of the latest model: out-of-sample (walk-forward backtest) and live (the\nsignals actually published and since resolved).",
        "operationId": "calibration_metrics_calibration_get",
        "parameters": [
          {
            "in": "query",
            "name": "timeframe",
            "required": false,
            "schema": {
              "default": "D1",
              "enum": ["D1", "W1", "M1"],
              "title": "Timeframe",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalibrationOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Calibration",
        "tags": ["metrics"]
      }
    },
    "/recommendations": {
      "get": {
        "description": "The day's ranked list, or an explicit \"no recommendation\" (the normal outcome whenever\nnothing passes the thresholds). ``date`` defaults to the latest day with a recorded run.",
        "operationId": "recommendations_recommendations_get",
        "parameters": [
          {
            "in": "query",
            "name": "timeframe",
            "required": false,
            "schema": {
              "default": "D1",
              "enum": ["D1", "W1", "M1"],
              "title": "Timeframe",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Date"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendationsOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Recommendations",
        "tags": ["recommendations"]
      }
    },
    "/signals/history": {
      "get": {
        "description": "Published signals, newest first, each with its realised outcome once the label window\nhas closed. ``realized_return`` is the gross barrier return, before costs.",
        "operationId": "signal_history_signals_history_get",
        "parameters": [
          {
            "in": "query",
            "name": "timeframe",
            "required": false,
            "schema": {
              "default": "D1",
              "enum": ["D1", "W1", "M1"],
              "title": "Timeframe",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "instrument_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Instrument Id"
            }
          },
          {
            "in": "query",
            "name": "outcome",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^(pending|tp|sl|sl_same_day|expiry)$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Outcome"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Signal History",
        "tags": ["signals"]
      }
    }
  }
}
